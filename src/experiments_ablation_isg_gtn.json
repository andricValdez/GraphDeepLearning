{
  "_comment": "OFAT ablation study for TransformerConv on ISG graphs. build_graph=false: graphs already built, only GNN retraining.",

  "defaults": {
    "mlflow_exp_name": "Ablation-Study-ISG-TransformerConv",
    "gnn_type": "TransformerConv",
    "build_graph": false,
    "graph_type": "undirected",
    "dataset_name": "autext23",
    "cut_off_dataset": "100_100_100",
    "cuda_num": 0,
    "edge_attr": true,
    "reduce_dim_emb": false,
    "add_pos_feat": true,
    "add_domain_feat": false,
    "project_after_concat": false,
    "reduced_dim": 256,
    "balance_dataset": true,
    "max_features": 20000,
    "min_df": 3,
    "max_df": 1.0,
    "stop_words": false,
    "special_chars": false,
    "patience": 10,
    "hidden_gnn_dim": 300,
    "dense_hidden_gnn_dim": 64,
    "num_gnn_layers": 2,
    "heads_gnn": 2,
    "dropout": 0.5,
    "lr": 0.00001,
    "norm_type": "batchnorm",
    "post_mp_layers": 2,
    "pooling_type": "mean",
    "lang_model_name": "microsoft/deberta-v3-base",
    "leave_out_sources": true,
    "use_token_distance_attn": false,
    "use_global_pooling": false
  },

  "experiments": [

    {
